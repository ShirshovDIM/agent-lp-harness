{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShirshovDIM/agent-lp-harness/schemas/report-v1.schema.json",
  "title": "LP verification report v1",
  "type": "object",
  "required": ["format_version", "chain_id", "pool", "window", "data_hash", "method_version",
               "n", "n_eff", "benchmarks", "modes", "caveats"],
  "properties": {
    "format_version": {"const": 1},
    "chain_id": {"type": "integer", "minimum": 1},
    "pool": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "position": {
      "type": ["object", "null"],
      "properties": {
        "id": {"type": ["string", "integer"]},
        "tick_lower": {"type": "integer"},
        "tick_upper": {"type": "integer"},
        "liquidity": {"type": "string"}
      }
    },
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"}
      }
    },
    "block_range": {
      "type": ["array", "integer"],
      "minItems": 2, "maxItems": 2
    },
    "data_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method_version": {"type": "string"},
    "n": {"type": "integer", "minimum": 1},
    "n_eff": {"type": "number", "minimum": 0},
    "benchmarks": {
      "type": "object",
      "required": ["hodl_5050_vs_quote"],
      "properties": {
        "hodl_5050_vs_quote": {
          "type": "object",
          "required": ["median"],
          "properties": {
            "median": {"type": "number"},
            "p10": {"type": "number"},
            "p90": {"type": "number"}
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "median", "p10", "p90"],
        "properties": {
          "name": {"type": "string"},
          "median": {"type": "number"},
          "p10": {"type": "number"},
          "p90": {"type": "number"},
          "P_lt_minus_5pct": {"type": "number"},
          "P_lt_minus_10pct": {"type": "number"},
          "wilson_p5_lower": {"type": "number"}
        }
      }
    },
    "calibration": {
      "type": ["object", "null"],
      "required": ["ratio", "source", "window"],
      "properties": {
        "ratio": {"type": "number"},
        "source": {"type": "string"},
        "position_id": {"type": ["string", "integer"]},
        "window": {"type": "object"}
      }
    },
    "caveats": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
